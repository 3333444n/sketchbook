{
  "name": "sketchbook",
  "version": "1.0.0",
  "description": "Sketchbook — an offline desktop whiteboard built with Excalidraw",
  "main": "./out/main/index.js",
  "author": "Luis Peregrino (https://github.com/3333444n)",
  "license": "MIT",
  "homepage": "https://github.com/3333444n/sketchbook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3333444n/sketchbook.git"
  },
  "bugs": {
    "url": "https://github.com/3333444n/sketchbook/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:mac": "pnpm run build && electron-builder --mac",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "sh scripts/make-icons.sh",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "mcp": "node out/main/mcp.js"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.4"
}
